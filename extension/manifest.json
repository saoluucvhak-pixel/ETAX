{
  "manifest_version": 3,
  "name": "eTax Manager - Cầu nối trang Thuế",
  "version": "1.3.14",
  "description": "Kết nối phiên đăng nhập trên hoadondientu.gdt.gov.vn với eTax Manager HAK Group (không gửi mật khẩu/token).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://hoadondientu.gdt.gov.vn/*",
    "https://hoadondientu.gdt.gov.vn:30000/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
