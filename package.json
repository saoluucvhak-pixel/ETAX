{
  "name": "etax-manager",
  "version": "1.3.22",
  "description": "Quản lý hóa đơn điện tử và làm việc với cổng Thuế điện tử (Web / PWA / Electron)",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/server.mjs",
    "check": "node -e \"const fs=require('fs'),path=require('path'),{execFileSync}=require('child_process');function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory()&&!p.includes('js'+path.sep+'lib'))walk(p);else if(/\\.(js|mjs|cjs)$/.test(e.name))execFileSync(process.execPath,['--check',p],{stdio:'inherit'});}}['js','server','electron','extension','tests'].forEach(walk);\"",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "vn.etax.manager",
    "productName": "eTax Manager HAK Group",
    "files": ["index.html", "manifest.json", "sw.js", "css/**", "js/**", "assets/**", "electron/**", "package.json"],
    "extraResources": ["extension"],
    "publish": null,
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "eTax Manager HAK Group" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
